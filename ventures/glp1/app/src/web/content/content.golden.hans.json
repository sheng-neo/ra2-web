 "coping": [
  {
   "id": "nausea",
   "title": "恶心、想吐",
   "forSymptoms": [
    "nausea",
    "vomiting",
    "reflux"
   ],
   "tryFirst": [
    "少量多餐，一次吃到\"刚好不饿\"就停，吃慢一点",
    "选清淡、凉一点、气味小的食物：白粥、苏打饼、酸奶、豆腐",
    "吃完别马上躺下，饭后至少隔 2 小时再睡",
    "小口多次喝水"
   ],
   "avoid": [
    "油腻、油炸、太辣、太甜的东西",
    "一次喝大量饮料",
    "吃撑"
   ],
   "seeDoctor": [
    "吐得喝水都留不住，或尿很少",
    "肚子剧烈疼，或疼到后背",
    "加量后一直不缓解"
   ],
   "sources": [
    "药品说明书：Wegovy、Zepbound 患者用药信息（FDA）",
    "ACLM/ASN/OMA/TOS 2025 年 GLP-1 营养与生活方式联合建议"
   ]
  },
  {
   "id": "constipation",
   "title": "便秘",
   "forSymptoms": [
    "constipation"
   ],
   "tryFirst": [
    "多喝水，饮水量比平时多一些",
    "纤维慢慢加：蔬菜、燕麦、豆类、水果，别一下子加很多",
    "每天走一走，饭后散步 10–15 分钟"
   ],
   "avoid": [
    "水喝太少",
    "一次性大量补纤维（会更胀）"
   ],
   "seeDoctor": [
    "超过 3 天没有排便，同时肚子疼、呕吐或明显腹胀",
    "便里有血或黑便",
    "用了通便方法还是不行，先问医生或药师"
   ],
   "sources": [
    "药品说明书：Wegovy、Zepbound 患者用药信息（FDA）",
    "ACLM/ASN/OMA/TOS 2025 年 GLP-1 营养与生活方式联合建议"
   ]
  },
  {
   "id": "no_appetite",
   "title": "没胃口、吃不下",
   "forSymptoms": [
    "no_appetite"
   ],
   "tryFirst": [
    "先吃蛋白：每餐先吃鸡蛋、豆腐、鱼肉，再吃主食",
    "吃不下固体就喝：牛奶、无糖豆浆、蛋白粉",
    "定时吃，每 3–4 小时吃一点，不等饿了才吃",
    "先保住\"最低线\"，理想线以后再说"
   ],
   "avoid": [
    "一整天不吃，晚上一次吃很多",
    "只吃零食和主食"
   ],
   "seeDoctor": [
    "连续好几天几乎吃不下",
    "体重掉得太快（每周超过 1.5%），或总是头晕没力气"
   ],
   "sources": [
    "药品说明书：Wegovy、Zepbound 患者用药信息（FDA）",
    "ACLM/ASN/OMA/TOS 2025 年 GLP-1 营养与生活方式联合建议"
   ]
  },
  {
   "id": "fatigue",
   "title": "疲劳、没力气",
   "forSymptoms": [
    "fatigue",
    "dizziness"
   ],
   "tryFirst": [
    "检查今天水喝够没有、蛋白吃够没有",
    "训练换成轻量版或改天，散步也算",
    "睡够，固定作息"
   ],
   "avoid": [
    "空腹做高强度运动",
    "起身太快"
   ],
   "seeDoctor": [
    "站起来眼前发黑、心慌",
    "在用胰岛素或磺脲类药，出现手抖出汗",
    "疲劳一直不缓解或越来越重"
   ],
   "sources": [
    "药品说明书：Wegovy、Zepbound 患者用药信息（FDA）",
    "ACLM/ASN/OMA/TOS 2025 年 GLP-1 营养与生活方式联合建议"
   ]
  }
 ],
 "routines": {
  "bodyweight": {
   "title": "徒手",
   "exercises": [
    {
     "name": "椅子坐站",
     "how": "坐在椅子前沿，双手抱胸，站起来再慢慢坐下",
     "standard": "3 组 × 10 次",
     "light": "2 组 × 8 次"
    },
    {
     "name": "靠墙俯卧撑",
     "how": "双手撑墙，身体成一条直线，胸口靠近墙再推回",
     "standard": "3 组 × 10 次",
     "light": "2 组 × 8 次"
    },
    {
     "name": "臀桥",
     "how": "仰卧屈膝，脚踩地，把臀部抬起再放下",
     "standard": "3 组 × 12 次",
     "light": "2 组 × 10 次"
    },
    {
     "name": "提踵",
     "how": "扶着桌子站好，踮起脚尖再放下",
     "standard": "3 组 × 15 次",
     "light": "2 组 × 12 次"
    },
    {
     "name": "平板支撑（跪姿也行）",
     "how": "前臂撑地，身体保持一条直线",
     "standard": "3 组 × 20 秒",
     "light": "2 组 × 15 秒"
    }
   ]
  },
  "band": {
   "title": "弹力带",
   "exercises": [
    {
     "name": "弹力带深蹲",
     "how": "脚踩弹力带，双手拉住放在肩前，下蹲再站起",
     "standard": "3 组 × 10 次",
     "light": "2 组 × 8 次"
    },
    {
     "name": "弹力带划船",
     "how": "弹力带绕过脚底或固定在门把手，向后拉到腰侧",
     "standard": "3 组 × 12 次",
     "light": "2 组 × 10 次"
    },
    {
     "name": "弹力带推胸",
     "how": "弹力带绕到背后，双手向前推",
     "standard": "3 组 × 10 次",
     "light": "2 组 × 8 次"
    },
    {
     "name": "弹力带侧走",
     "how": "弹力带套在膝盖上方，半蹲向侧面走",
     "standard": "3 组 × 10 步",
     "light": "2 组 × 8 步"
    },
    {
     "name": "弹力带面拉",
     "how": "弹力带固定在高处，向脸的方向拉开",
     "standard": "3 组 × 12 次",
     "light": "2 组 × 10 次"
    }
   ]
  },
  "dumbbell": {
   "title": "哑铃",
   "exercises": [
    {
     "name": "高脚杯深蹲",
     "how": "双手捧一只哑铃在胸前，下蹲再站起",
     "standard": "3 组 × 10 次",
     "light": "2 组 × 8 次"
    },
    {
     "name": "单臂划船",
     "how": "一手撑椅子，另一手把哑铃拉到腰侧",
     "standard": "3 组 × 10 次/侧",
     "light": "2 组 × 8 次/侧"
    },
    {
     "name": "哑铃推举",
     "how": "坐着把哑铃从肩膀推到头顶",
     "standard": "3 组 × 10 次",
     "light": "2 组 × 8 次"
    },
    {
     "name": "罗马尼亚硬拉",
     "how": "膝盖微弯，臀部向后推，哑铃沿腿下放再站起",
     "standard": "3 组 × 10 次",
     "light": "2 组 × 8 次"
    },
    {
     "name": "农夫走",
     "how": "双手各拿一只哑铃，挺胸走",
